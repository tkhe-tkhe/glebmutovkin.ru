---
// Обо мне: портрет слева, текст справа. Текст живёт в src/data/o-mne.ts,
// чтобы правка слов не задевала разметку.
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import portret from '../../images/portret.jpg';
import { abzacy } from '../../data/o-mne';
---

<Base
  title="Обо мне — Глеб Мутовкин"
  description="Родился в Казани в 1979 году, с двух лет живу в Москве. Школа на Арбате и работа последние двадцать два года там же — Арбат мой второй дом."
>
  <main class="page omne" data-pagefind-ignore>
    <section class="hero">
      <h1>Обо мне</h1>
    </section>

    <section class="omne-row">
      <figure>
        <Image
          src={portret}
          alt="Глеб Мутовкин"
          widths={[272, 544, 816]}
          sizes="(min-width:900px) 17rem, (max-width:720px) 20rem, 100vw"
        />
        <figcaption>Арбат, 2026</figcaption>
      </figure>

      <div class="txt">
        {abzacy.map((p) => <p>{p}</p>)}
        <p><a class="link" href="https://vk.ru/id49789194">ВКонтакте</a></p>
      </div>
    </section>
  </main>
</Base>
