---
// Витрина музыки. Короткая входная страница: студийная запись звучит сразу,
// остальное разложено по полкам. Полки живут на отдельных страницах —
// вместе они дают простыню в три тысячи пикселей.

import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import TekstPop from '../../components/TekstPop.astro';
import m from '../../data/muzyka.json';
import { sklon, TEKST, ZAPIS } from '../../lib/sklon';
import dannye from '../../data/stihi.json';
import { vidno } from '../../data/razdely';

const dni = m.studiya[0];
const tekstDney = dannye.teksty.find((t) => t.slug === dni.tekst);

// Собрание текстов целиком — включая те, что звучат в клипах и концертах.
// Стоит здесь, а не отдельным пунктом меню: тексты песен и так живут
// в музыке, разводить их по разным углам сайта незачем.
const stihov = dannye.teksty.length;

const koncertnyh = m.koncerty.reduce((n, k) => n + k.treki.length, 0);

const dva = (n: number) => String(n).padStart(2, '0');

// Полки: каждая гасится своим переключателем в razdely.json. Номера
// проставляются после отбора, а не записаны руками, — иначе выключенная
// полка оставила бы дырку в счёте: 01, 03, 04.
const polki = [
  {
    vidna: vidno.muzyka_klipy,
    title: 'Клипы',
    href: '/muzyka/klipy/',
    meta: 'видео на песни · YouTube',
    kolvo: m.klipy.length,
  },
  {
    vidna: vidno.muzyka_koncerty,
    title: 'Концерты',
    href: '/muzyka/koncerty/',
    meta: `живые записи · ${m.koncerty.length} концерта · YouTube`,
    kolvo: koncertnyh,
  },
  {
    vidna: vidno.muzyka_instrumentaly,
    title: 'Инструментальная музыка',
    href: '/muzyka/instrumentaly/',
    meta: 'гитарные пьесы · SoundCloud',
    kolvo: m.instrumentaly.length,
  },
  {
    vidna: vidno.muzyka_stihi,
    title: 'Тексты песен',
    href: '/muzyka/stihi/',
    meta: 'слова к песням',
    kolvo: stihov,
  },
]
  .filter((p) => p.vidna)
  .map((p, i) => ({ ...p, n: dva(i + 1) }));

// Счёт в строке «Собрание» считаем по тем же полкам, что показаны. Обещать
// восемьдесят записей и показывать одну полку — хуже, чем не обещать ничего.
// Студийная запись стоит выше списка и звучит всегда, поэтому она в счёте
// независимо от полок.
const vsego =
  m.studiya.length +
  (vidno.muzyka_klipy ? m.klipy.length : 0) +
  (vidno.muzyka_koncerty ? koncertnyh : 0) +
  (vidno.muzyka_instrumentaly ? m.instrumentaly.length : 0);
const tekstov = vidno.muzyka_stihi ? stihov : 0;

---

<Base
  title="Музыка — Глеб Мутовкин"
  description="«Смешное время»: студийные записи, клипы, концерты и гитарные пьесы."
>
  <main class="page" data-pagefind-ignore>
    <section class="hero">
      <h1>Музыка</h1>
      <p class="lede">
        Всё музыкальное — «Смешное время». Музыка, тексты и аранжировки мои;
        играю один или с командой, но проект всегда называется так.
      </p>
    </section>

    <section>
      <div class="count" style="margin-bottom:1rem">Студийная запись</div>
      <Player
        title={dni.title}
        god={dni.god}
        dur={dni.dur}
        mp3={dni.mp3}
        m4a={dni.m4a}
        ssylki={dni.ssylki}
      />

      {tekstDney && (
        <>
          <button type="button" class="tekst" data-tekst={tekstDney.slug}>Текст</button>
          <template data-tekst-dlya={tekstDney.slug}>
            <h3>{tekstDney.title}</h3>
            {tekstDney.strofy.map((strofa) => (
              <p class="verse">
                {strofa.map((stroka, i) => (
                  <>
                    {i > 0 && <br />}
                    {stroka}
                  </>
                ))}
              </p>
            ))}
          </template>
        </>
      )}
    </section>

    {polki.length > 0 && (
    <section>
      <div class="count" style="margin-bottom:1.2rem">
        Собрание — {vsego} {sklon(vsego, ZAPIS)}
        {tekstov > 0 && <> и {tekstov} {sklon(tekstov, TEKST)}</>}
      </div>

      <ul class="cat">
        {polki.map((p) => (
          <li>
            <span class="num">{p.n}</span>
            <a href={p.href}>
              <span class="ct">{p.title}</span>
              <div class="cm">{p.meta}</div>
            </a>
            <span class="cn">{dva(p.kolvo)}</span>
          </li>
        ))}
      </ul>
    </section>
    )}
  </main>

  <TekstPop />
</Base>
