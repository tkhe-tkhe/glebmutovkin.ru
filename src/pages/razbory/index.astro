---
// Каталог разборов.
//
// Список тем и их порядок живут в src/data/razbory-plan.json — там же, откуда
// счётчик «Разбор — NN / NN» на самой странице разбора берёт общее число.
// Тема считается собранной, если для неё есть src/data/razbory/<slug>.json.
// «Человек перед Богом» помечен в плане своей страницей: у него отдельный
// шаблон с карточками терминов.
//
// Несобранные темы показываю без ссылки, чтобы объём собрания был виден честно.

import Base from '../../layouts/Base.astro';
import plan from '../../data/razbory-plan.json';
import { sklon, STRANICA } from '../../lib/sklon';

const meta = import.meta.glob('../../data/razbory/*.json', { eager: true });
const toma = import.meta.glob('../../data/toma/*.json', { eager: true });

const sobrannye = new Map(
  Object.entries(meta).map(([put, mod]: [string, any]) => [
    put.split('/').pop()!.replace('.json', ''),
    mod.default ?? mod,
  ])
);

const sobrannye_toma = new Map(
  Object.entries(toma).map(([put, mod]: [string, any]) => [
    put.split('/').pop()!.replace('.json', ''),
    mod.default ?? mod,
  ])
);

const temy = plan.temy.map((t) => {
  const m = sobrannye.get(t.slug);
  if (t.tom) {
    // Том: одна строка в каталоге, как у остальных, но подпись говорит,
    // что внутри несколько страниц — иначе «~14 часов» читается как ошибка.
    const v = sobrannye_toma.get(t.slug);
    if (!v) return { ...t, gotov: false, podpis: `${t.oblast} · в работе`, god: '' };
    const stranic = v.chasti.reduce((s: number, c: any) => s + c.stranicy.length, 0) + 1;
    return {
      ...t,
      gotov: true,
      href: `/razbory/${t.slug}/`,
      podpis:
        `${t.oblast} · ${v.chasti.length} частей, ` +
        `${stranic} ${sklon(stranic, STRANICA)} · ~${Math.round(v.min / 60)} ч`,
      god: v.god,
    };
  }
  if (t.svoya_stranica) {
    // «Человек перед Богом»: собран вручную, метрики берём из его страницы
    return {
      ...t,
      gotov: true,
      href: `/razbory/${t.slug}/`,
      podpis: `${t.oblast} · 38 источников · ~79 мин`,
      god: '2026',
    };
  }
  if (!m) return { ...t, gotov: false, podpis: `${t.oblast} · в работе`, god: '' };
  return {
    ...t,
    gotov: true,
    href: `/razbory/${t.slug}/`,
    podpis: `${t.oblast} · ${Object.keys(m.istochniki).length} источников · ~${m.min} мин`,
    god: m.god,
  };
});

const gotovyh = temy.filter((t) => t.gotov).length;
const dva = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Разборы — Глеб Мутовкин"
  description="Своды по темам: собрано и сверено из проверенных источников."
>
  <main class="page" data-pagefind-ignore>
    <section class="hero">
      <h1>Разборы</h1>
      <p class="lede">
        Своды по темам: вопрос, проверенные источники, сверка и структура. Долгое чтение,
        всё в одном месте. Положения принадлежат источникам, отбор и порядок — мои.
      </p>
    </section>

    <section>
      <div class="count" style="margin-bottom:1.2rem">
        Готово — {dva(gotovyh)} / {dva(temy.length)}
      </div>

      <ul class="cat">
        {temy.map((t) =>
          t.gotov ? (
            <li>
              <span class="num">{t.n}</span>
              <a href={t.href}>
                <span class="ct">{t.title}</span>
                <div class="cm">{t.podpis}</div>
              </a>
              <span class="cn">{t.god}</span>
            </li>
          ) : (
            <li style="opacity:.5">
              <span class="num">{t.n}</span>
              <div>
                <span class="ct">{t.title}</span>
                <div class="cm">{t.podpis}</div>
              </div>
              <span class="cn"></span>
            </li>
          )
        )}
      </ul>
    </section>
  </main>
</Base>
