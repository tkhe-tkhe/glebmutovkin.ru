---
// Фасад ролика YouTube.
// Голый <iframe> тянет больше мегабайта скриптов ещё до нажатия play — и делает это
// для каждого ролика на странице. Здесь вместо плеера лежит превью (15–30 КБ),
// а настоящий плеер подставляется по нажатию.

interface Props {
  id: string;      // идентификатор ролика на YouTube
  title: string;
  dur?: string;
  n?: string;      // номер в сетлисте концерта
  tekst?: string;  // slug текста песни в stihi.json
}

const { id, title, dur, n, tekst } = Astro.props;

// Текст песни живёт рядом со своей записью — это её каноническое место.
// Закрыт по умолчанию: пятнадцать раскрытых текстов превратили бы полку
// в простыню, ради которой и разносили страницы.
import dannye from '../data/stihi.json';
const stih = tekst ? dannye.teksty.find((t) => t.slug === tekst) : undefined;
---

<figure class="vid">
  <button type="button" class="embed" data-yt={id} data-title={title}>
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      decoding="async"
      width="480"
      height="360"
      onerror="this.remove()"
    />
    <span class="play">Смотреть</span>
  </button>
  <figcaption>
    <span class="vt">{title}</span>
    <span class="vm">{n && <span class="vn">{n}</span>}{dur}</span>

    {stih && (
      <>
        <button type="button" class="tekst" data-tekst={stih.slug}>Текст</button>
        <template data-tekst-dlya={stih.slug}>
          <h3>{stih.title}</h3>
          {stih.strofy.map((strofa: string[]) => (
            <p class="verse">
              {strofa.map((stroka, i) => (
                <>
                  {i > 0 && <br />}
                  {stroka}
                </>
              ))}
            </p>
          ))}
        </template>
      </>
    )}
  </figcaption>
</figure>

<script>
  // Один обработчик на всю страницу: слушаем документ, а не каждый фасад.
  // Astro собирает этот скрипт один раз, сколько бы фасадов ни было на странице.
  document.addEventListener('click', (e) => {
    const box = (e.target as HTMLElement).closest<HTMLElement>('.embed[data-yt]');
    if (!box) return;

    const id = box.dataset.yt;
    const frame = document.createElement('iframe');
    // Домен обычный, а не youtube-nocookie.com. Проверено 15 августа в Chrome Глеба:
    // на nocookie ролик отвечает «Войдите в аккаунт, чтобы подтвердить, что вы не бот»,
    // на обычном домене тот же ролик открывается сразу. Приватность обменяна
    // на то, что видео вообще играет.
    frame.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
    frame.title = box.dataset.title ?? '';
    frame.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    frame.allowFullscreen = true;

    const live = document.createElement('div');
    live.className = 'embed live';
    live.appendChild(frame);
    box.replaceWith(live);
  });
</script>

<script is:inline>
  // Панель с текстом песни. Одна на страницу: содержимое берём из <template>
  // рядом с нажатой кнопкой. Раскрывать текст внутри полки нельзя — сетка
  // растягивается, и соседние места в ряду остаются пустыми.
  if (!window.__tekstPesni) {
    window.__tekstPesni = true;

    let pop = null;
    let shtora = null;

    function zakryt() {
      pop?.remove();
      shtora?.remove();
      pop = shtora = null;
    }

    document.addEventListener('click', (e) => {
      const knopka = e.target.closest('button.tekst');
      if (knopka) {
        zakryt();
        const tpl = document.querySelector(
          `template[data-tekst-dlya="${knopka.dataset.tekst}"]`
        );
        if (!tpl) return;

        shtora = document.createElement('div');
        shtora.className = 'tekst-shtora';
        document.body.appendChild(shtora);

        pop = document.createElement('div');
        pop.className = 'tekst-pop';
        pop.appendChild(tpl.content.cloneNode(true));

        const x = document.createElement('button');
        x.className = 'px';
        x.type = 'button';
        x.setAttribute('aria-label', 'Закрыть');
        x.textContent = '×';
        x.onclick = zakryt;
        pop.appendChild(x);

        document.body.appendChild(pop);
        return;
      }
      if (pop && !e.target.closest('.tekst-pop')) zakryt();
    });

    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') zakryt();
    });
  }
</script>
