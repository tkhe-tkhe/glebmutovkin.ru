---
// Каркас гайда.
//
// Оснастка проще, чем у разбора: липкое оглавление, плашка происхождения,
// список источников внизу. Полосы прочитанного и всплывающих карточек
// источника нет — гайд читают выборочно, по разделу, а не подряд час.
// Сноска [UA-4] — обычная ссылка на строку списка внизу.
//
// Тело лежит отдельным HTML-файлом и подставляется через ?raw: таблицы,
// врезки и пути в интерфейсе в Markdown не выражаются.

import Base from './Base.astro';
import { vidno } from '../data/razdely';
import { faily } from '../lib/skachat';

interface Props {
  meta: {
    slug: string;
    title: string;
    lede: string;
    oblast: string;
    data: string;
    slov: number;
    min: number;
    // Текст плашки «Как читать этот гайд». У гайдов про звук он про железо
    // и версии приборов; справочнику по сети такой не годится. Пусто —
    // берётся текст по умолчанию. {n} подставляется числом источников.
    kak_chitat?: string;
    toc: { href: string; label: string; uroven?: number }[];
    istochniki: Record<string, { title: string; url?: string }>;
  };
  body: string;
}

const { meta, body } = Astro.props;
const nsrc = Object.keys(meta.istochniki).length;
const skachat = faily(meta.slug);

// Текст по умолчанию — про звук: два первых гайда именно про него.
// Число источников подставляется, чтобы не разъехалось при правке гайда.
const PO_UMOLCHANIYU =
  'Инструкция, собранная под мою конфигурацию и проверенная по {n} источникам: ' +
  'документация производителей и руководства к приборам. Настройки привязаны ' +
  'к конкретному железу и версиям — переносить их на другую сборку без проверки не стоит.';
const kakChitat = (meta.kak_chitat || PO_UMOLCHANIYU).replace('{n}', String(nsrc));
---

<Base title={`${meta.title} — Глеб Мутовкин`} description={meta.lede}>
  <main class="page">
    <div style="max-width:44rem;margin-bottom:3rem">
      <div class="count" style="margin-bottom:1.1rem">Гайд</div>
      <h1>{meta.title}</h1>
      <p class="lede" style="margin:1.2rem 0 1rem">{meta.lede}</p>
      <p class="meta">
        {meta.data} · {meta.slov.toLocaleString('ru')} слов · ~{meta.min} мин чтения
      </p>

      <div class="origin">
        <b>Как читать этот гайд</b>
        <p>{kakChitat}</p>
        <p>Область: {meta.oblast}</p>
      </div>

      {skachat.length > 0 && (
        <div class="skachat">
          <b>Скачать</b>
          <ul>
            {skachat.map((f) => (
              <li>
                {/* download заставляет браузер сохранить файл, а не открыть
                    его во вкладке — иначе HTML и PDF просто заменят страницу */}
                <a href={f.url} download>{f.label}</a>
                <span>{f.chto} · {f.ves}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="reading">
      <aside class="toc">
        <b>Содержание</b>
        {meta.toc.map((t) => (
          <a href={t.href} class={t.uroven === 2 ? 'l2' : undefined}>{t.label}</a>
        ))}
      </aside>

      <article
        class="razbor gaid"
        data-pagefind-body={vidno.gaidy ? '' : undefined}
      >
        <details class="toc-m">
          <summary>Содержание</summary>
          {meta.toc.map((t) => (
            <a href={t.href} class={t.uroven === 2 ? 'l2' : undefined}>{t.label}</a>
          ))}
        </details>

        <Fragment set:html={body} />
      </article>
    </div>
  </main>

  <script is:inline>
    // Подсветка текущего раздела в оглавлении — как у разбора.
    const links = [...document.querySelectorAll('.toc a')];
    // следим и за разделами, и за карточками: в справочнике по плагинам
    // весь второй уровень оглавления — это section[id]
    const heads = [...document.querySelectorAll('article.gaid h2[id], article.gaid section[id]')];
    if (links.length && heads.length) {
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            links.forEach((l) => l.classList.remove('on'));
            const a = links.find((l) => l.getAttribute('href') === '#' + e.target.id);
            if (a) a.classList.add('on');
          }),
        { rootMargin: '-8% 0px -75% 0px' }
      );
      heads.forEach((h) => io.observe(h));
    }
  </script>
</Base>
