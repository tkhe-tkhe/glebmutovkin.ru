---
// Общий шаблон всех страниц: голова документа, шапка, подвал.
// Всё, что между шапкой и подвалом, приезжает через <slot />.

import '@fontsource-variable/literata';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tkhe.css';
import { pokazyvat as gaidyVidny } from '../data/gaidy';
import Znak from '../components/Znak.astro';
import { zakryt } from '../data/sait';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Музыка, разборы и заметки на полях.',
  noindex = false,
} = Astro.props;

const nav = [
  { href: '/', label: 'Лента' },
  { href: '/muzyka/', label: 'Музыка' },
  { href: '/esse/', label: 'Эссе и проза' },
  { href: '/razbory/', label: 'Разборы' },
  // Пункт появляется, только когда раздел открыт: src/data/gaidy.ts
  ...(gaidyVidny ? [{ href: '/gaidy/', label: 'Гайды' }] : []),
  { href: '/foto/', label: 'Фото' },
  { href: '/o-mne/', label: 'Обо мне' },
];

// Текущий раздел: на главной точное совпадение, в остальных — по началу пути.
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {/* Иконка вкладки — личный знак Глеба. Три файла, потому что браузеры
        разные: svg берут все современные (он же переворачивается в тёмной теме),
        ico остаётся для старых и для закладок Windows, apple-touch-icon
        подхватывает iOS, когда сайт добавляют на домашний экран. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || zakryt) && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <header class="chrome" data-pagefind-ignore>
      <a class="brand" href="/">
        <Znak />
        <span>Глеб Мутовкин</span>
      </a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="site" data-pagefind-ignore>
      <div style="max-width:42rem">
        glebmutovkin.ru — музыка, разборы и заметки.<br />
        Материалы можно свободно цитировать со ссылкой на источник.<br /><br />
        <a href="/">Лента</a> · <a href="/o-mne/">Обо мне</a> · <a href="/poisk/">Поиск</a>
      </div>
    </footer>
  </body>
</html>
