---
// Общий шаблон всех страниц: голова документа, шапка, подвал.
// Всё, что между шапкой и подвалом, приезжает через <slot />.

import '@fontsource-variable/literata';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tkhe.css';
import { vidno, skryt as razdelSkryt } from '../data/razdely';
import Znak from '../components/Znak.astro';
import { zakryt } from '../data/sait';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Музыка, разборы и заметки на полях.',
  noindex = false,
} = Astro.props;

// Меню собирается из открытых разделов: src/data/razdely.ts. Лента стоит
// всегда — это главная. Порядок задан здесь, а не в данных: он про смысл
// («музыка первична»), а не про настройку.
const nav = [
  { href: '/', label: 'Лента' },
  ...(vidno.muzyka ? [{ href: '/muzyka/', label: 'Музыка' }] : []),
  ...(vidno.esse ? [{ href: '/esse/', label: 'Эссе и проза' }] : []),
  ...(vidno.razbory ? [{ href: '/razbory/', label: 'Разборы' }] : []),
  ...(vidno.gaidy ? [{ href: '/gaidy/', label: 'Гайды' }] : []),
  ...(vidno.foto ? [{ href: '/foto/', label: 'Фото' }] : []),
  ...(vidno.o_mne ? [{ href: '/o-mne/', label: 'Обо мне' }] : []),
];

// Текущий раздел: на главной точное совпадение, в остальных — по началу пути.
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Страница скрытого раздела: noindex. Считается здесь, в одном месте
// на весь сайт, а не в каждом макете по отдельности — иначе новая страница
// однажды приедет без этой проверки и утечёт в выдачу.
//
// Поиск по сайту отсюда закрыть нельзя: data-pagefind-ignore на <body>
// Pagefind не читает — body для него и есть корень страницы. Проверено
// 20 августа 2026: с меткой на body разборы продолжали попадать в индекс.
// Поэтому индексацию гасят те макеты, где стоит data-pagefind-body:
// Razbor.astro, Gaid.astro и chelovek-pered-bogom.astro. Витрины разделов
// в индекс не попадают и так — у них data-pagefind-ignore на <main>.
const naSkrytoy = razdelSkryt(path);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {/* Иконка вкладки — личный знак Глеба. Три файла, потому что браузеры
        разные: svg берут все современные (он же переворачивается в тёмной теме),
        ico остаётся для старых и для закладок Windows, apple-touch-icon
        подхватывает iOS, когда сайт добавляют на домашний экран. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || zakryt || naSkrytoy) && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <header class="chrome" data-pagefind-ignore>
      <a class="brand" href="/">
        <Znak />
        <span>Глеб Мутовкин</span>
      </a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        {/* Поиск — значком, а не восьмым словом: семь пунктов держатся
            в строку впритык, слово «Поиск» сломало бы её на планшете.
            До этой лупы поиск был виден только тому, кто дочитал до подвала. */}
        <a
          class="poisk"
          href="/poisk/"
          aria-label="Поиск по сайту"
          aria-current={path.startsWith('/poisk') ? 'page' : undefined}
        >
          <svg class="lupa" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4" />
            <line x1="12.6" y1="12.6" x2="17" y2="17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </a>
      </nav>
    </header>

    <slot />

    <footer class="site" data-pagefind-ignore>
      <div style="max-width:42rem">
        glebmutovkin.ru — музыка, разборы и заметки.<br />
        Материалы можно свободно цитировать со ссылкой на источник.<br /><br />
        {/* «Обо мне» уходит из подвала вместе с разделом: скрытый раздел,
            на который сайт сам же и ссылается, — это не скрытый раздел */}
        <a href="/">Лента</a>{vidno.o_mne && <Fragment> · <a href="/o-mne/">Обо мне</a></Fragment>}
        {' · '}<a href="/poisk/">Поиск</a>
      </div>
    </footer>
  </body>
</html>
