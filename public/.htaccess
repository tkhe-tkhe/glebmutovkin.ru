# glebmutovkin.ru — правила Apache на хостинге nic.ru.
#
# Файл лежит в public/ и попадает в dist/ при сборке, поэтому едет на сервер
# вместе с сайтом и не может «отстать» от него.
#
# Сайт статический: ни PHP, ни базы. Здесь только четыре вещи —
# один адрес вместо четырёх, своя страница 404, кэш и сжатие.

# ---------------------------------------------------------------------------
# 1. Один канонический адрес: https://glebmutovkin.ru
#    Без этого одна и та же страница живёт по четырём адресам (http/https,
#    с www и без), а поисковик считает их разными и делит вес между ними.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https. На nic.ru за прокси-сервером признак защищённого соединения
  # приходит заголовком, поэтому проверяем оба варианта.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://glebmutovkin.ru/$1 [R=301,L]

  # www → без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Своя страница 404 вместо апачевой
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# 3. Кэш
#    Имена файлов в /_astro/ содержат хэш содержимого: меняется содержимое —
#    меняется имя. Поэтому их можно кэшировать навсегда.
#    HTML кэшировать нельзя: по тем же адресам приезжает новое содержимое.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType audio/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Мелочи безопасности: не давать угадывать тип файла и не течь адресами
  # страниц на чужие сайты.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# 4. Сжатие текста
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 5. Файлы для скачивания: /files/
#    Гайд лежит там же в pdf, docx, epub и html. HTML-копия — то же самое
#    содержимое по второму адресу, и поисковик засчитал бы её дублем страницы
#    гайда. Закрываем заголовком, а не строкой в robots.txt: Disallow виден
#    всем, кто откроет файл, а X-Robots-Tag — только роботу.
#
#    Заголовок ставится по адресу, а не по имени файла: FilesMatch в .htaccess
#    смотрит только на имя и о папке ничего не знает.
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/files/" SKACHAT
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex" env=SKACHAT
</IfModule>

# Типы, которые Apache может не знать: без них браузер получает octet-stream
# и, например, не предлагает открыть epub в читалке.
<IfModule mod_mime.c>
  AddType application/epub+zip .epub
  AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
</IfModule>

# ---------------------------------------------------------------------------
# 6. Кодировка и мелочи
# ---------------------------------------------------------------------------
AddDefaultCharset utf-8
Options -Indexes
